@@ _Startup.scs
 197:
 	ResetFlag 1883
 	CallFar 1, 59
 	FlagOnJump 1240, 198
+	FlagOffJump 1353, 198
 	LoadMenuInit
 	Jump 180
 198:
 	LoadMenuDirectInit
 	Jump 182
+401:
# Pause gameplay
+	Call 304
+	$W(1012) |= 12;
# Call load menu procedure
+	Call 197
+	SetFlag 1332
+	FlagOffJump 1883, @label(load_menu_close)
+	ResetFlag 1332
+	$T(48) = $W(2123);
+	Jump 199
+402:
# Pause gameplay
+	Call 304
+	$W(1012) |= 12;
# Call quick-load menu procedure
+	Call 178
+	SetFlag 1332
+	FlagOffJump 1883, @label(load_menu_close)
+	ResetFlag 1332
+	$T(48) = $W(2123);
+	Jump 199
+@label(load_menu_close):
+	$W(1041) = 0;
+	$W(1040) = 0;
# Resume gameplay
+	Call 305
+	$W(1012) &= 243;
# Return to main loop
+	Jump 65

# Direct Save Menu
@@ _Startup.scs
 	Jump 65
+403:
+	CallFar 1, 58
+	SSEplay 6
+	SaveMenuDirectInit
+	$W(1042) = 0;
+	$W(1040) = 0;
+	SetFlag 1351
+	SetFlag 1227
+ $W(1043) = 256;
+ $W(1041) = 256;
+@label(save_menu_open):
+	Wait 1
+	$W(1042) ++;
+	If $W(1042) < 64, @label(save_menu_open)
+	$W(1042) = 10000;
+	$W(1040) = 0;
+ Call 202
+ Jump 65
 200:

@@ _Startup.scs
