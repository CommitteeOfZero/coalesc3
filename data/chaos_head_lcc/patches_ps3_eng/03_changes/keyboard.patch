# Add keyboard shortcuts to submenus
# Labels for direct menu jumps are hard-coded and start at 400
@@ _Startup.scs
 	KeyOnJump2 12, 1, 168
	KeyOnJump2 21, 1, 133
	KeyOnJump2 13, 1, 79
# Backlog - F2
+	KeyboardOnJump03 52, 1, 168
# Tips - F4
+	KeyboardOnJump03 54, 1, 133
# Config - F9
+	KeyboardOnJump03 57, 1, 400
# Load - F5
+	KeyboardOnJump03 55, 1, 401
# Save - F6
+	KeyboardOnJump03 56, 1, 403
# Quickload - F7
+	KeyboardOnJump03 58, 1, 402
# Title - F10
+	KeyboardOnJump03 61, 1, 404

	Jump 65
 66:
	If $W(2300) == 65535, 65

# Direct Config Menu
@@ _Startup.scs
	$W(1040) ++;
	If $W(1040) < 64, 155
	Jump 158
+400:
+	Call 304
+	$W(1012) |= 12;
+	$W(1042) = 0;
+	$W(1040) = 0;
+ Call 156
+	Call 305
+	$W(1012) &= 243;
+	Jump 65

